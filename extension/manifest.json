{
  "manifest_version": 3,
  "name": "Ortak İzle",
  "version": "1.0.0",
  "description": "Disney+, HBO Max, Apple TV+ ve diğerlerinde birlikte izleme: ortak oynat/durdur/sar, sohbet, kim ne açtı.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ortak İzle",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
  },
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "content_scripts": [
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://tv.apple.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.youtube.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.netflix.com/*"],
      "js": ["netflix-main.js"],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "browser_specific_settings": {
    "gecko": { "id": "ortak-izle@kardesler", "strict_min_version": "128.0" },
    "gecko_android": { "strict_min_version": "128.0" }
  }
}

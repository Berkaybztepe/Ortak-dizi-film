{
  "manifest_version": 3,
  "name": "Ortak İzle",
  "version": "2.4.1",
  "description": "Disney+, HBO Max, Apple TV+ ve diğerlerinde birlikte izleme: ortak oynat/durdur/sar, sohbet, tepkiler, kim ne açtı.",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "shared/room-client.js",
      "background.js"
    ]
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Ortak İzle",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://tv.apple.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.com.tr/*",
        "https://*.youtube.com/*",
        "https://*.exxen.com/*",
        "https://*.gain.tv/*",
        "https://*.tod.tv/*",
        "https://*.tabii.com/*"
      ],
      "js": [
        "shared/engine.js",
        "overlay.js",
        "content.js"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://*.netflix.com/*"
      ],
      "js": [
        "netflix-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "shared/fonts/*.woff2"
      ],
      "matches": [
        "https://*.disneyplus.com/*",
        "https://*.max.com/*",
        "https://*.hbomax.com/*",
        "https://tv.apple.com/*",
        "https://*.netflix.com/*",
        "https://*.primevideo.com/*",
        "https://*.amazon.com/*",
        "https://*.amazon.com.tr/*",
        "https://*.youtube.com/*",
        "https://*.exxen.com/*",
        "https://*.gain.tv/*",
        "https://*.tod.tv/*",
        "https://*.tabii.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "ortak-izle@kardesler",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
